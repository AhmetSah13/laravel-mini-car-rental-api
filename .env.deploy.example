# Registry tag — prefer immutable SHA tags from GHCR (sha-<git-sha>)
IMAGE_TAG=latest

APP_NAME="Mini Car Rental"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Postgres container bootstrap (must match DB_* above)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb

RATE_LIMITING_ENABLED=true

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Laravel → Reverb (Docker DNS)
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
